{
  "browser_specific_settings": {
    "gecko": {
      "id": "seo-inspector@brianvoit",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteActivity"],
        "optional": []
      }
    }
  },
  "permissions": ["menus", "webRequestBlocking"],
  "background": {
    "scripts": ["background.js"]
  },
  "sidebar_action": {
    "default_panel": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Marketing Inspector"
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Toggle the Marketing Inspector sidebar"
    }
  }
}
